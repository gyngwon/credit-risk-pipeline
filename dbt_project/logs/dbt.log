[0m15:02:43.281006 [debug] [Thread-1 (]: On model.credit_risk_pipeline.int_borrower_employment: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "dbt_project", "target_name": "dev", "node_id": "model.credit_risk_pipeline.int_borrower_employment"} */

  
  create view "credit_risk"."main"."int_borrower_employment__dbt_tmp" as (
    with stg as (
    select * from "credit_risk"."main"."stg_loans"
),

parsed as (
    select
        loan_id,
        employment_length_raw,

        case
            when employment_length_raw = 'n/a' then null
            when employment_length_raw = '< 1 year' then 0
            when employment_length_raw = '10+ years' then 10
            else try_cast(
                regexp_extract(employment_length_raw, '(\d+)', 1) as integer
            )
        end as employment_length_years,

        -- Convenience bucket for grouping in dashboards
        case
            when employment_length_raw = 'n/a' then 'unknown'
            when employment_length_raw = '< 1 year' then '0-1 years'
            when try_cast(regexp_extract(employment_length_raw, '(\d+)', 1) as integer) <= 3
                then '1-3 years'
            when try_cast(regexp_extract(employment_length_raw, '(\d+)', 1) as integer) <= 6
                then '4-6 years'
            when employment_length_raw = '10+ years' then '10+ years'
            else '7-9 years'
        end as employment_length_bucket

    from stg
)

select * from parsed
  );

[0m15:02:43.281569 [debug] [Thread-2 (]: SQL status: OK in 0.001 seconds
[0m15:02:43.281730 [debug] [Thread-2 (]: Using duckdb connection "model.credit_risk_pipeline.int_loan_status_flags"
[0m15:02:43.281946 [debug] [Thread-2 (]: On model.credit_risk_pipeline.int_loan_status_flags: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "dbt_project", "target_name": "dev", "node_id": "model.credit_risk_pipeline.int_loan_status_flags"} */

  
  create view "credit_risk"."main"."int_loan_status_flags__dbt_tmp" as (
    with stg as (
    select * from "credit_risk"."main"."stg_loans"
),

flagged as (
    select
        loan_id,
        loan_status,

        -- Terminal (resolved) vs. still-active loans.
        -- "Does not meet the credit policy" statuses are legacy LendingClub
        -- labels for loans that were later reclassified for policy reasons,
        -- but the underlying outcome (paid vs. charged off) is still valid,
        -- so they're folded into the same terminal buckets.
        case
            when loan_status in (
                'Fully Paid',
                'Does not meet the credit policy. Status:Fully Paid'
            ) then true
            else false
        end as is_fully_paid,

        case
            when loan_status in (
                'Charged Off',
                'Does not meet the credit policy. Status:Charged Off'
            ) then true
            else false
        end as is_default,

        case
            when loan_status in ('Late (31-120 days)', 'Late (16-30 days)') then true
            else false
        end as is_late,

        case
            when loan_status = 'In Grace Period' then true
            else false
        end as is_in_grace_period,

        case
            when loan_status = 'Current' then true
            else false
        end as is_current,

        -- A single top-level status used for grouping in the mart layer
        case
            when loan_status in (
                'Fully Paid',
                'Does not meet the credit policy. Status:Fully Paid'
            ) then 'paid'
            when loan_status in (
                'Charged Off',
                'Does not meet the credit policy. Status:Charged Off'
            ) then 'default'
            when loan_status in ('Late (31-120 days)', 'Late (16-30 days)') then 'late'
            when loan_status = 'In Grace Period' then 'grace_period'
            when loan_status = 'Current' then 'current'
            else 'unknown'
        end as risk_status

    from stg
)

select * from flagged
  );

