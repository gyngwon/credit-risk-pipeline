[0m15:50:55.568655 [debug] [Thread-1 (]: On model.credit_risk_pipeline.int_borrower_risk_metrics: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "dbt_project", "target_name": "dev", "node_id": "model.credit_risk_pipeline.int_borrower_risk_metrics"} */

  
  create view "credit_risk"."main"."int_borrower_risk_metrics__dbt_tmp" as (
    with stg as (
    select * from "credit_risk"."main"."stg_loans"
),

metrics as (
    select
        loan_id,
        fico_range_low,
        fico_range_high,
        dti,
        revolving_utilization,

        -- Use the midpoint of the FICO range as a single representative score
        (fico_range_low + fico_range_high) / 2.0 as fico_score,

        -- FICO risk tiers, based on common industry bucketing
        case
            when fico_range_low is null then 'unknown'
            when fico_range_low < 580 then 'poor'
            when fico_range_low < 670 then 'fair'
            when fico_range_low < 740 then 'good'
            when fico_range_low < 800 then 'very_good'
            else 'excellent'
        end as fico_bucket,

        -- DTI (debt-to-income) risk tiers
        case
            when dti is null then 'unknown'
            when dti < 15 then 'low'
            when dti < 30 then 'moderate'
            when dti < 40 then 'high'
            else 'very_high'
        end as dti_bucket,

        -- Revolving utilization tiers (how much of available revolving
        -- credit the borrower is currently using)
        case
            when revolving_utilization is null then 'unknown'
            when revolving_utilization < 30 then 'low'
            when revolving_utilization < 60 then 'moderate'
            else 'high'
        end as revolving_utilization_bucket

    from stg
)

select * from metrics
  );

