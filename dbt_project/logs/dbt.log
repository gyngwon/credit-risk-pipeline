  create view "credit_risk"."main"."int_borrower_employment__dbt_tmp" as (
    with stg as (
    select * from "credit_risk"."main"."stg_loans"
),

parsed as (
    select
        loan_id,
        employment_length_raw,

        case
            when employment_length_raw = 'n/a' then null
            when employment_length_raw = '< 1 year' then 0
            when employment_length_raw = '10+ years' then 10
            else try_cast(
                regexp_extract(employment_length_raw, '(\d+)', 1) as integer
            )
        end as employment_length_years,

        -- Convenience bucket for grouping in dashboards
        case
            when employment_length_raw = 'n/a' then 'unknown'
            when employment_length_raw = '< 1 year' then '0-1 years'
            when try_cast(regexp_extract(employment_length_raw, '(\d+)', 1) as integer) <= 3
                then '1-3 years'
            when try_cast(regexp_extract(employment_length_raw, '(\d+)', 1) as integer) <= 6
                then '4-6 years'
            when employment_length_raw = '10+ years' then '10+ years'
            else '7-9 years'
        end as employment_length_bucket

    from stg
)

select * from parsed
  );

[0m15:31:02.953685 [debug] [Thread-1 (]: On model.credit_risk_pipeline.int_borrower_risk_metrics: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "dbt_project", "target_name": "dev", "node_id": "model.credit_risk_pipeline.int_borrower_risk_metrics"} */

  
  create view "credit_risk"."main"."int_borrower_risk_metrics__dbt_tmp" as (
    with stg as (
    select * from "credit_risk"."main"."stg_loans"
),

metrics as (
    select
        loan_id,
        grade,
        sub_grade,
        dti,
        revolving_utilization,

        -- LendingClub's own credit grade doubles as the risk tier here,
        -- since this dataset extract doesn't include FICO score columns
        case
            when grade in ('A', 'B') then 'low_risk'
            when grade in ('C', 'D') then 'moderate_risk'
            when grade in ('E', 'F', 'G') then 'high_risk'
            else 'unknown'
        end as credit_risk_tier,

        case
            when dti is null then 'unknown'
            when dti < 15 then 'low'
            when dti < 30 then 'moderate'
            when dti < 40 then 'high'
            else 'very_high'
        end as dti_bucket,

        case
            when revolving_utilization is null then 'unknown'
            when revolving_utilization < 30 then 'low'
            when revolving_utilization < 60 then 'moderate'
            else 'high'
        end as revolving_utilization_bucket

    from stg
)

select * from metrics
  );

