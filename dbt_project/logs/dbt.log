        stg.loan_id,
        stg.grade,
        stg.sub_grade,
        risk.dti_bucket,
        risk.revolving_utilization_bucket,
        risk.credit_risk_tier

    from stg
    left join risk on stg.loan_id = risk.loan_id
)

select * from credit_profile
    );
    
  
