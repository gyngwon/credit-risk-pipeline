    create  table
      "credit_risk"."main"."dim_borrowers__dbt_tmp"
  
    
    as (
      with stg as (
    select * from "credit_risk"."main"."stg_loans"
),

employment as (
    select * from "credit_risk"."main"."int_borrower_employment"
),

borrowers as (
    select
        md5(cast(coalesce(cast(stg.loan_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as borrower_id,
        stg.loan_id,
        stg.state,
        stg.home_ownership,
        stg.verification_status,
        stg.annual_income,
        employment.employment_length_years,
        employment.employment_length_bucket

    from stg
    left join employment on stg.loan_id = employment.loan_id
)

select * from borrowers
    );
    
  
[0m15:31:02.987642 [debug] [Thread-1 (]: Using duckdb connection "model.credit_risk_pipeline.int_loan_status_flags"
[0m15:31:02.988145 [debug] [Thread-1 (]: On model.credit_risk_pipeline.int_loan_status_flags: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "dbt_project", "target_name": "dev", "node_id": "model.credit_risk_pipeline.int_loan_status_flags"} */

  
  create view "credit_risk"."main"."int_loan_status_flags__dbt_tmp" as (
    with stg as (
    select * from "credit_risk"."main"."stg_loans"
),

flagged as (
    select
        loan_id,
        loan_status,

        -- Terminal (resolved) vs. still-active loans.
        -- "Does not meet the credit policy" statuses are legacy LendingClub
        -- labels for loans that were later reclassified for policy reasons,
        -- but the underlying outcome (paid vs. charged off) is still valid,
        -- so they're folded into the same terminal buckets.
        case
            when loan_status in (
                'Fully Paid',
                'Does not meet the credit policy. Status:Fully Paid'
            ) then true
            else false
        end as is_fully_paid,

        case
            when loan_status in (
                'Charged Off',
                'Does not meet the credit policy. Status:Charged Off'
            ) then true
            else false
        end as is_default,

        case
            when loan_status in ('Late (31-120 days)', 'Late (16-30 days)') then true
            else false
        end as is_late,

        case
            when loan_status = 'In Grace Period' then true
            else false
        end as is_in_grace_period,

        case
            when loan_status = 'Current' then true
            else false
        end as is_current,

        -- A single top-level status used for grouping in the mart layer
        case
            when loan_status in (
                'Fully Paid',
                'Does not meet the credit policy. Status:Fully Paid'
            ) then 'paid'
            when loan_status in (
                'Charged Off',
                'Does not meet the credit policy. Status:Charged Off'
            ) then 'default'
            when loan_status in ('Late (31-120 days)', 'Late (16-30 days)') then 'late'
            when loan_status = 'In Grace Period' then 'grace_period'
            when loan_status = 'Current' then 'current'
            else 'unknown'
        end as risk_status

    from stg
)

select * from flagged
  );

